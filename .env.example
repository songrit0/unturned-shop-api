PORT=3000
FRONTEND_URL=http://localhost:4200

# MySQL (เหมือนบอท/plugin)
DB_HOST=
DB_PORT=3306
DB_NAME=unturned
DB_USER=
DB_PASSWORD=
SV_PREFIX=sv_
RC_PREFIX=rc_

# Cash bill item ids (match plugin's NoCommissionItemIds + bot's BILL_ITEM_IDS)
BILL_ITEM_IDS=4254,4255,4256,4257,4258

# Real-money top-up: Meowcoins credited per 1 THB (legacy alias VCOIN_PER_BAHT still read as a fallback)
MEOWCOIN_PER_BAHT=1

# Donate: per-user cap (baht) per calendar month and community-wide monthly goal (baht). Both reset monthly.
TOPUP_MONTHLY_CAP_BAHT=150
TOPUP_MONTHLY_GOAL_BAHT=1200

# Wealth tax (coin sink): deduct WEALTH_TAX_PERCENT of balance from users whose balance > WEALTH_TAX_THRESHOLD
# Runs on cron expression below (default: every day at 03:00 server time). Set percent=0 to disable.
WEALTH_TAX_PERCENT=2
WEALTH_TAX_THRESHOLD=10000
WEALTH_TAX_CRON=0 3 * * *

# Player-to-player Coin transfer: FLAT fee burned (sink), paid by sender on top of the amount.
# COIN_TRANSFER_MIN must be greater than COIN_TRANSFER_FEE.
COIN_TRANSFER_FEE=200
COIN_TRANSFER_MIN=201

# Discord OAuth (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# ตั้งใน Discord Developer Portal → OAuth2 → Redirects
# ใช้ ngrok URL: https://<your-ngrok>.ngrok-free.app/auth/discord/callback
DISCORD_REDIRECT_URI=

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d

# Admin Discord IDs (comma-separated)
ADMIN_DISCORD_IDS=

# ngrok (https://dashboard.ngrok.com/auth)
NGROK_AUTHTOKEN=
# Optional: reserved domain so the URL doesn't change every restart
# Create one (free, 1 per account) at https://dashboard.ngrok.com/cloud-edge/domains
# Example: my-shop.ngrok-free.app   (use the bare domain, not the https:// URL)
NGROK_DOMAIN=

# Firebase Admin (download from Firebase Console → Project settings → Service accounts)
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-admin.json
# Firestore doc to publish the live ngrok URL into
FIREBASE_API_URL_DOC=config/apiUrl

# BuyMeACoffee donation webhook (Settings → Webhooks on the BMC dashboard).
# Donors put their steamID64 in the supporter message; the webhook credits that account.
BMC_WEBHOOK_SECRET=
# Fixed USD->THB rate used to convert BMC donations into baht for the shared cap/tier system.
BMC_USD_TO_THB=36
# Public BuyMeACoffee page URL shown as a donate link on the web. Leave empty to hide it.
BMC_PAGE_URL=https://www.buymeacoffee.com/yourpage
